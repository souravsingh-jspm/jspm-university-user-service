generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PageSection {
  HOME
  SCHOOL
  NONE
}

enum PageType {
  TOP
  HEADER
  FOOTER
  MAIN
  NONE
}

enum ContentType {
  CONTENT_PAGE
  URL
}

enum TargetType {
  SELF
  NEW
}

enum ContentBlockType {
  TITLE
  PARAGRAPH
  RICH_TEXT
  SINGLE_FILE
  GRID_TITLE
  MULTIPLE_IMAGE_GRID
}


enum EventType{
  HOME
  SCHOOL
}

model CmsPage {
  cms_id               String              @id @default(uuid())
  cms_page_name        String       
  cms_slug             String              @unique
  cms_parent_id        String?              
  cms_page_order       Int                 @default(1) 
  cms_external_url     String?             @db.Text
  cms_page_title       String     
  cms_meta_description String?             @db.Text
  cms_meta_keywords    String?             @db.Text
  cms_is_published     Boolean             @default(false) 
  cms_school_id        String?     
  cms_is_active        Boolean             @default(true) // soft delete page
  cms_section          PageSection         @default(HOME) // home page or school page
  cms_page_type        PageType            @default(NONE) // display on top, or just create page
  cms_content_type     ContentType         @default(CONTENT_PAGE) // page holds content or it's url
  cms_target           TargetType          @default(SELF) // should open on new page or same page

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  parent               CmsPage?            @relation("PageHierarchy", fields: [cms_parent_id], references: [cms_id], onDelete: SetNull)
  
  children             CmsPage[]           @relation("PageHierarchy")
  
  school               School?             @relation(fields: [cms_school_id], references: [school_id], onDelete: SetNull)

  pageContentBlocks    PageContentBlock[]  @relation("PageContentBlock")
  
  @@index([cms_slug])
  @@index([cms_section])
  @@index([cms_school_id])
  @@index([cms_is_published])
  @@index([cms_parent_id])
  @@map("cms_pages")
}

model School {
  school_id             String           @id @default(uuid())
  school_name           String           @unique
  school_slug           String           @unique
  school_description    String?          @db.Text
  school_is_active      Boolean          @default(true) @map("is_active") // soft delete school
  createdAt             DateTime         @default(now())  @map("created_at")
  updatedAt             DateTime         @updatedAt       @map("updated_at")
  BLOGS       BLOGS[]
  EVENTS      EVENTS[]
  
  pages       CmsPage[]
  
  @@map("schools")
}

model PageContentBlock {
  page_content_block_id           String           @id @default(uuid())
  cms_page_id                     String           
  page_content_block_type         ContentBlockType @map("block_type")
  page_content_block_title        String?          @db.Text
  page_content_block_content      String?          @db.LongText
  page_content_block_file_url     String?          @db.Text
  page_content_block_file_id      String?          
  page_content_block_sort_order   Int              @default(0) 
  page_content_block_is_published Boolean          @default(true) 
  createdAt                       DateTime         @default(now()) @map("created_at")
  updatedAt                       DateTime         @updatedAt @map("updated_at")
  page                            CmsPage          @relation("PageContentBlock", fields: [cms_page_id], references: [cms_id], onDelete: Cascade)
  @@index([cms_page_id])
  @@index([page_content_block_type])
  @@index([page_content_block_file_id])
  @@index([page_content_block_sort_order])
  @@map("page_content_blocks")
}

model EVENTS { 
  event_id                String           @id @default(uuid())
  event_title             String?
  event_image1_file_id    String?
  event_image2_file_id    String?
  event_short_description String?          @db.Text
  event_long_description  String?          @db.LongText
  event_place             String? 
  event_type              EventType        @default(HOME)
  event_school_id               String?
  event_date              DateTime?
  school                   School?             @relation(fields: [event_school_id], references: [school_id], onDelete: SetNull)
  event_is_active         Boolean?          @default(true)
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")
}

model BLOGS { 
  blog_id                  String           @id @default(uuid())
  blog_title               String?
  blog_image1_file_id      String?
  blog_image2_file_id      String?
  blog_short_description   String?          @db.Text
  blog_long_description    String?          @db.LongText
  blog_type                EventType        @default(HOME)
  blog_school_id           String?
  blog_date                DateTime?
  school                   School?          @relation(fields: [blog_school_id], references: [school_id], onDelete: SetNull)
  blog_is_active           Boolean?         @default(true)
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")
}